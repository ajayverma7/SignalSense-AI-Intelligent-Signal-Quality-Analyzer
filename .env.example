# =============================================================================
# SignalSense AI – Environment Variables Template
# Rename this file to .env and fill in your actual credentials.
# This file is safe to commit to GitHub (no real values inside).
# =============================================================================

# IBM watsonx.ai API Key (from IBM Cloud IAM → API Keys)
WATSONX_API_KEY=your_api_key_here

# IBM watsonx.ai Project ID (from watsonx.ai → Manage → General → Project ID)
WATSONX_PROJECT_ID=your_project_id_here

# IBM watsonx.ai Regional Endpoint URL
# Dallas (US South) : https://us-south.ml.cloud.ibm.com
# Frankfurt (EU)    : https://eu-de.ml.cloud.ibm.com
# Tokyo (AP North)  : https://jp-tok.ml.cloud.ibm.com
# Sydney (AP South) : https://au-syd.ml.cloud.ibm.com
# London (EU GB)    : https://eu-gb.ml.cloud.ibm.com
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# Flask settings (optional)
FLASK_DEBUG=false
FLASK_PORT=5000
