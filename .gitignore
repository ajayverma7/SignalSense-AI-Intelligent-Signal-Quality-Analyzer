# =============================================================================
# SignalSense AI - .gitignore
# =============================================================================

# ----- Environment & Secrets -----
.env
*.env
.env.local
.env.production
.env.staging
secrets.py
config_local.py

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/
.venv/
.ENV/
virtualenv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# Pytest / testing
.pytest_cache/
.coverage
htmlcov/
*.xml
nosetests.xml
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ----- IDE & Editors -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# ----- Logs & Temp Files -----
*.log
logs/
*.tmp
*.temp
tmp/
temp/

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Flask / Werkzeug -----
instance/
.webassets-cache
flask_session/

# ----- Uploads -----
uploads/
*.uploaded.csv

# ----- Node (if any frontend tooling added later) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
